# Copy this file to .env in this folder (collector/.env) and fill in values.
# Default: Qwen (Alibaba DashScope) for file upload and data extraction (OCR).
# For scanned/image-only PDF uploads:
#   1. Set DASHSCOPE_API_KEY below (get key: https://www.alibabacloud.com/help/en/model-studio/get-api-key)
#   2. Install Ghostscript and add it to your PATH (used to convert PDF pages to images for Qwen OCR):
#      Windows: https://ghostscript.com/releases/gsdnload.html (add bin folder to PATH)
#      macOS: brew install ghostscript
#   3. Restart the document processor (collector)

# DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_OCR_MODEL=qwen-vl-ocr-2025-11-20
