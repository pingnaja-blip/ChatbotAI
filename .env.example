# =============================================================================
# ChatbotAI – Consolidated Credential Reference
# =============================================================================
# Copy this to server/.env or docker/.env and fill in your values.
# NEVER commit actual .env files. Use .env.example as templates.
#
# For AI-assisted code generation: When credentials are required, use
# process.env.VAR_NAME (server) or import.meta.env.VITE_VAR (frontend).
# =============================================================================

# ---- Auth & Server ----
# JWT_SECRET=                         # Min 12 chars. Required for multi-user.
# AUTH_TOKEN=                         # Single-user password. Required for cloud.
# SERVER_PORT=3001
# NODE_ENV=production
# STORAGE_DIR=/app/server/storage     # Docker only

# ---- Database ----
# DATABASE_URL=                       # Only if using PostgreSQL (Prisma)

# ---- LLM Providers (pick one) ----
# LLM_PROVIDER=openai
# OPEN_AI_KEY=                        # sk-...
# OPEN_MODEL_PREF=gpt-4o

# LLM_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_KEY=
# OPEN_MODEL_PREF=...

# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL_PREF=claude-2

# LLM_PROVIDER=ollama
# OLLAMA_BASE_PATH=http://host.docker.internal:11434
# OLLAMA_MODEL_PREF=llama2

# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_LLM_MODEL_PREF=gemini-pro

# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# GROQ_MODEL_PREF=llama3-8b-8192

# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL_PREF=openrouter/auto

# ---- Embedding (if needed) ----
# EMBEDDING_ENGINE=openai
# OPEN_AI_KEY=sk-...
# EMBEDDING_MODEL_PREF=text-embedding-ada-002

# ---- Vector Database (pick one) ----
# VECTOR_DB=lancedb                  # Default
# VECTOR_DB=pinecone
# PINECONE_API_KEY=
# PINECONE_INDEX=
# VECTOR_DB=chroma
# CHROMA_ENDPOINT=http://localhost:8000
# CHROMA_API_KEY=
# VECTOR_DB=astra
# ASTRA_DB_APPLICATION_TOKEN=
# ASTRA_DB_ENDPOINT=
# VECTOR_DB=qdrant
# QDRANT_ENDPOINT=http://localhost:6333
# QDRANT_API_KEY=
# VECTOR_DB=weaviate
# WEAVIATE_ENDPOINT=http://localhost:8080
# WEAVIATE_API_KEY=
# VECTOR_DB=milvus
# MILVUS_ADDRESS=http://localhost:19530
# MILVUS_USERNAME=
# MILVUS_PASSWORD=
# VECTOR_DB=zilliz
# ZILLIZ_ENDPOINT=
# ZILLIZ_API_TOKEN=

# ---- Audio / TTS ----
# WHISPER_PROVIDER=local
# TTS_PROVIDER=native
# TTS_OPEN_AI_KEY=                   # If TTS=openai
# TTS_ELEVEN_LABS_KEY=               # If TTS=elevenlabs

# ---- Agent Search ----
# AGENT_GSE_KEY=                     # Google Search
# AGENT_GSE_CTX=
# AGENT_SERPER_DEV_KEY=              # Serper.dev
# AGENT_BING_SEARCH_API_KEY=         # Bing Search

# ---- Huawei Cloud (ECS / SWR) ----
# Used for Docker login, push/pull to SWR. See docker/DEPLOYMENT-HUAWEI-CLOUD.md
# HUAWEI_AK=                         # Access Key from IAM
# HUAWEI_SK=                         # Secret Key from IAM
# HUAWEI_SWR_REGION=ap-southeast-2   # e.g. ap-southeast-2
# HUAWEI_SWR_ORG=                    # SWR org name (e.g. my-org)
# HUAWEI_SWR_IMAGE=swr.<region>.myhuaweicloud.com/<org>/anything-llm:latest

# ---- Frontend (frontend/.env, VITE_ prefix) ----
# VITE_API_BASE=http://localhost:3001/api
